{
  "manifest_version": 3,
  "name": "MV3 Starter",
  "version": "0.1.0",
  "description": "Starting point for a Manifest V3 extension that does real work in the browser and never uploads anything.",

  "permissions": ["activeTab", "scripting", "offscreen", "storage", "alarms", "contextMenus"],

  "background": { "service_worker": "background.js" },

  "options_ui": { "page": "options.html", "open_in_tab": true },

  "action": { "default_title": "MV3 Starter (Ctrl+Shift+Y)" },

  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" }
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
